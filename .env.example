# Postgres connection (Opalstack-managed)
DATABASE_URL="postgresql://user:pass@host:5432/printshop"

# Where uploads / generated PDFs are written on disk (Opalstack home dir)
STORAGE_ROOT="./storage"

# Public origin used for absolute URLs (webhooks, share links)
APP_ORIGIN="http://localhost:3000"

# --- Shopify ---
SHOPIFY_SHOP="myshop.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_WEBHOOK_SECRET=""

# --- Fulfillment ---
# stub: writes PDFs to storage/outbox/ locally (default for v1)
# zoo:  uploads to ZooPrinting SFTP using vars below
FULFILLER="stub"
ZOO_SFTP_HOST=""
ZOO_SFTP_PORT="22"
ZOO_SFTP_USER=""
ZOO_SFTP_PASSWORD=""
ZOO_SFTP_KEY_PATH=""
ZOO_SFTP_REMOTE_DIR="/incoming"
